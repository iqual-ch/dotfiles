{{- if and (eq .chezmoi.os "linux") .enable_mise -}}
#!/bin/bash
# mise config hash: {{ include "private_dot_config/mise/config.toml" | sha256sum }}

set -eufo pipefail

export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise &>/dev/null; then
  echo "[mise] mise is not installed yet, skipping tool installation."
  exit 0
fi

echo "[mise] Installing mise tools..."
mise install --yes
echo "[mise] Tools installed successfully."
{{ end -}}
